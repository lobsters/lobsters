<p>
  If you've forgotten your password, enter your e-mail address or username
  below and instructions will be e-mailed to you.
</p>

<div class="flash-notice">
  2026-10-17: we're having <a href="https://gist.github.com/pushcx/e59839c44403ea224f37a33c20232cbe#user-content-email">email deliverability problems</a>. Try the form once, and if you get a 500 or the email doesn't arrive, please come ask for help in <a href="/chat">chat</a>.
</div>

<%= form_with url: reset_password_path do |f| %>
  <div class="labelled_grid">
    <%= f.label :email, "E-mail or Username" %>
    <%= f.text_field :email, size: 40, autofocus: :autofocus, inputmode: :email, autocapitalize: :off, autocorrect: :off %>
  </div>

  <%= f.submit "Reset Password" %>
<% end %>
