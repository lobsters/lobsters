<%# locals: () -%>
<%= render @above if @above %>

<ol class="stories list <%= action_name == "hidden" ? "show_hidden" : "" %>">
  <%
    last_read_index = if action_name == "newest" && @last_read_timestamp
      @stories.index { @last_read_timestamp.after?(it.created_at) }
    end
    unseen, seen = last_read_index ? [@stories[0...last_read_index], @stories[last_read_index..]] : [@stories, []]
  %>
  <%= render partial: "stories/listdetail", collection: unseen, as: :story %>
  <% if last_read_index %>
    <div class="last_read_newest">Last Read</div>
  <% end %>
  <%= render partial: "stories/listdetail", collection: seen, as: :story %>
</ol>

<%= render @below if @below %>

<nav class="morelink">
  <% if @page && @page > 1 %>
    <%= link_to raw("Page #{@page - 1}"), @root_path ? "/page/#{@page - 1}" : { controller: controller_name, action: action_name, page: @page - 1 }.merge(@next_page_params || {}), rel: "prev" %>
  <% end %>

  <% if @show_more %>
    <% if @page && @page > 1 %>
      <%= divider_tag %>
    <% end %>
    <%= link_to raw("Page #{@page + 1}"), @root_path ? "/page/#{@page + 1}" : { controller: controller_name, action: action_name, page: @page + 1 }.merge(@next_page_params || {}), rel: "next" %>
  <% end %>
</nav>
