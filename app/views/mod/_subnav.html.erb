<%# locals: () -%>
<% content_for :subnav do %>
  <li class="push-right"><%= link_to_different_page 'Activity', mod_path %></li>
  <% if controller_name == 'mod_inbox' %>
    Inbox: <%= link_to_different_page 'All', mod_inbox_all_path %> <%= link_to_different_page 'Unread', mod_inbox_unread_path %>
  <% else %>
    <%= link_to 'Inbox', mod_inbox_path %>
  <% end %>
  <% if controller_name == 'flagged' && action_name == 'commenters' %>
    Commenters: <% %w{1m 2m 3m 6m}.each do |p| %><%= link_to_different_page(p, mod_commenters_path(period: p)) %> <% end %>
  <% else %>
    <%= link_to 'Commenters', mod_commenters_path(period: '1m') %>
  <% end %>
<% end %>
