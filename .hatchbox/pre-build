#!/bin/bash

# runs in dir of new release before it's symlinked into place

# avatars live in a shrared dir (until #547) and we don't want to flush that
# cache every deploy; this mirrors the symlinking in hatchbox's deploy script
mkdir -p ../../shared/public/avatars
ln -s ../../../shared/public/avatars public/avatars

# similarly, we carry the full-page cache for unauthenticated users between deploys
mkdir -p ../../shared/public/cache
ln -s ../../../shared/public/cache public/cache

mkdir -p /home/deploy/lobsters/shared/database-backups

# prod keys
cp --preserve=mode,timestamps /home/deploy/lobsters/shared/etc/credentials.yml.enc config/credentials.yml.enc
cp --preserve=mode,timestamps /home/deploy/lobsters/shared/etc/master.key config/master.key
cp --preserve=mode,timestamps /home/deploy/lobsters/shared/etc/database.yml config/database.yml

# confirm unattended upgrades is on and configured
if cmp -s hatchbox/20auto-upgrades /etc/apt/apt.conf.d/20auto-upgrades; then
    echo "Ubuntu unattended security updates are enabled, good."
else
    echo "Ubuntu unattended security updates are NOT enabled or the config has changed."
    echo "as root, run: dpkg-reconfigure --priority=low unattended-upgrades"
    echo "more info: https://help.ubuntu.com/community/AutomaticSecurityUpdates"
    exit 1
fi

current=/home/deploy/lobsters/current
if ! diff -q <(ls "$current/db/migrate") <(ls db/migrate) >/dev/null; then
    echo "new migration(s), taking a backup"
    (cd "$current" && RAILS_ENV=production bundle exec rails runner "ResticJob.perform_now") || exit 1
fi

mkdir -p ../../shared/mockturtle/storage.leveldb
ln -s ../../../shared/mockturtle/storage.leveldb mockturtle/storage.leveldb
(cd mockturtle && yarn install --frozen-lockfile --production) || exit 1
