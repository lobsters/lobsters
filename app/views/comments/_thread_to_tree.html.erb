<%# locals: (comment:, comment_counter:, comment_iteration:, collection_thread:, story:, ribbon:, force_open:, show_tree_lines:, show_hotspot_terms:, show_folder_control:) -%>

<%# if there's no next comment, close back to the first comment %>
<% next_depth = collection_thread[comment_counter + 1]&.depth || collection_thread[0].depth %>
<% finished_subtrees = comment.depth - next_depth + 1 %>

<%# open the subtree this comment is in and render it %>
<li class="comments_subtree">
  <%= yield %>

  <%# open the nested <ol> for replies, which may be empty %>
  <ol class="comments">

<%# close as many subtrees as the next comment is shallower %>
<% finished_subtrees.times do %>
  </ol>
</li>
<% end %>
