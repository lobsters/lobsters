# Bind Anubis to localhost. It doesn't need to be public and spoofable. 
BIND=127.0.0.1:9000
TARGET=http://localhost:9001
POLICY_FNAME=/etc/anubis/lobsters.botPolicies.yaml
DIFFICULTY=4
# Prometheus also doesn't need to be public.
METRICS_BIND=127.0.0.1:9090
SERVE_ROBOTS_TXT=0
REDIRECT_DOMAINS="lobste.rs"
